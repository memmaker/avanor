debian/.debhelper/
avanor_*.deb

# Generated by rpmbuild
rpmbuild/
avanor-*.rpm
dmgroot/
resources/Avanor.icns

# Source archives
avanor-*-src.tar.gz
avanor-*-src.zip

# Game state
avanor.hsc
dmp*.txt

# Build files
obj/
obj-d/

# Fetched by the Makefile - see STC_HEADER and ARGPARSE_HEADER
external/

